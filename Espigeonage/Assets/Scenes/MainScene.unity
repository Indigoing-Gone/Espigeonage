  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Hello there, Mr.  D'Amboise!\r\n\r\n\tI dare say it\u2019s been some time
    since I\u2019ve heard from you last, so I figured I\u2019d more likely be the
    one to extend the courtesy of a letter, and here we are. Been awful quiet as
    of late, but I\u2019ve only just recently come into some knowledge that may be
    of interest to us. I seem to recall our services being employed by that old [mob
    name idk] to keep our peepers pricked for anything that may be providing unneeded
    competition for them. I seem to recall them offering to pay awful well if we
    found anything, too.\r\n\tAs it happens, I was making my rounds down [street
    name] when I saw a man whom I have not had the displeasure of acquainting myself
    with in some time. Old trouble boy of mine. Don\u2019t remember who he might
    have been affiliated with, but seeing him around acting all shady is a sure sign
    of something amiss. All I can give you for now is his name, [name], but I\u2019ll
    be waiting if anything breaks bad. I\u2019m none too sure anything will make
    its way to the street, so it might be in our best interest to get some of our
    more hands-on associates into the building. Looks like some sort of clothing
    shop. I can get you the address too; look it up in one of them books of yours
    and maybe you\u2019ll find something worthwhile. Well, I\u2019m afraid the night
    beckons to me once again. I\u2019ll look forward to our next correspondence,
    which better be from you to me. I am a lady, after all.\r\n\r\nCiao,\r\nLena
    \r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
