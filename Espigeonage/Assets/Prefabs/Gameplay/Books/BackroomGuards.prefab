      propertyPath: pageData.Array.data[1].text
      value: 'Backroom Guard Schedule


        Monday: Davie/L5 facing South, Ron/G11
        facing South, Grant/L7 facing West, Irvine/A5 facing East'
      objectReference: {fileID: 0}
    - target: {fileID: 5584456545367877786, guid: 65bb05c044fce4e47b1932f2b25f35dc, type: 3}
      propertyPath: pageData.Array.data[2].text
      value: 'Tuesday: Bruce/G1 facing East, Ron/7E facing West, Grant/E3 facing
        North, Irvine/I7 facing South'
      objectReference: {fileID: 0}
    - target: {fileID: 5584456545367877786, guid: 65bb05c044fce4e47b1932f2b25f35dc, type: 3}
      propertyPath: pageData.Array.data[3].text
      value: 'Wednesday: Bruce/E6 facing West, Davie/J3 facing East, Grant/J6 facing
        North, Irvine/C9 facing East'
      objectReference: {fileID: 0}
    - target: {fileID: 5584456545367877786, guid: 65bb05c044fce4e47b1932f2b25f35dc, type: 3}
      propertyPath: pageData.Array.data[4].text
      value: 'Thursday: Bruce/I1 facing East, Davie/5A facing East, Ron/H7 facing
        West, Irvine/F11 facing South'
      objectReference: {fileID: 0}
    - target: {fileID: 5584456545367877786, guid: 65bb05c044fce4e47b1932f2b25f35dc, type: 3}
      propertyPath: pageData.Array.data[5].text
      value: 'Friday: Bruce/K6 facing South, Davie/E1 facing East, Ron/H6 facing
        South, Grant/C11 facing West

'
      objectReference: {fileID: 0}
    - target: {fileID: 5584456545367877786, guid: 65bb05c044fce4e47b1932f2b25f35dc, type: 3}
      propertyPath: pageData.Array.data[6].text
      value: 'Weekend: Bruce, Davie, Ron, Grant, and Irvine doing rounds'
      objectReference: {fileID: 0}
    - target: {fileID: 5584456545367877786, guid: 65bb05c044fce4e47b1932f2b25f35dc, type: 3}
      propertyPath: pageData.Array.data[7].text
      value: "Note for Boss\r\nHey Boss,\r\n\r\nI\u2019m thinking we gotta have a
        talk about respect around here. Grant made fun of Bruce for being so short
        he can\u2019t see over"
      objectReference: {fileID: 0}
    - target: {fileID: 5584456545367877786, guid: 65bb05c044fce4e47b1932f2b25f35dc, type: 3}
      propertyPath: pageData.Array.data[8].text
      value: "a table. It\u2019s true, but you just don\u2019t say that sort of thing
        to a guy. Maybe we should keep them separated for a while. Also, I get we\u2019re
        going for ambiance,"
      objectReference: {fileID: 0}
    - target: {fileID: 5584456545367877786, guid: 65bb05c044fce4e47b1932f2b25f35dc, type: 3}
      propertyPath: pageData.Array.data[9].text
      value: "but even Davie can\u2019t see more than twenty feet in front of him.
        Can we get some more light back there?\n\nRon"
      objectReference: {fileID: 0}
